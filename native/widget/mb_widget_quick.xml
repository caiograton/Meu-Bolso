<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mb_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="46dp"
        android:layout_height="52dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/mb_widget_glyph" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mb_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Meu Bolso"
            android:textColor="#CCF5F3EF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/mb_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="€ 18,50"
            android:textColor="#F5F3EF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mb_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="último lançamento"
            android:textColor="#CCF5F3EF"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mb_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/mb_widget_btn"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="+"
            android:textColor="#B9800F"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mb_btn_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="Lançamento\nrápido"
            android:textColor="#7B1F2A"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
