<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="radial"
                android:centerX="0.2"
                android:centerY="0.0"
                android:gradientRadius="320dp"
                android:startColor="#FFFDF8"
                android:centerColor="#F5F0E7"
                android:endColor="#ECE5D9" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#8CC9A55A" />
        </shape>
    </item>
</layer-list>
